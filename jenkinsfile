pipeline {
    agent any
    stages{
        stage("build_stage"){
            steps{
                echo "building project...."
            }
        }
        stage("test_stage"){
            steps{
                echo "testing project...."
            }
        }
        stage("deploy_stage"){
            steps{
                echo "deploying project..."
            }
        }
    }
    post{
        always{
            echo "thank you"
        }
    }
}
